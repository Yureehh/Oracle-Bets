# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.uv-cache/
.pre-commit-cache/
nosetests.xml
coverage.xml
*.cover

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# DotEnv configuration
.env

# Database
*.db
*.rdb

# Pycharm
.idea

# VS Code
.vscode/

# Spyder
.spyproject/

# Jupyter NB Checkpoints
.ipynb_checkpoints/

# Generated data/artifact trees. Keep folder READMEs visible.
/data/*
!/data/README.md
!/data/lol/
/data/lol/*
!/data/lol/README.md
!/data/lol/**/
!/data/lol/**/README.md
/artifacts/

# Mac OS-specific storage files
.DS_Store

# vim
*.swp
*.swo

# Mypy cache
.mypy_cache/

# Pyre type checker
*.pyc

# Poetry files
poetry

# All csv files
*.csv

# All parquet files
*.parquet

# Catboost info
catboost_info/

# Model outputs (generated files)
/models/*
!/models/README.md
!/models/lol/
/models/lol/*
!/models/lol/README.md
!/models/lol/**/
!/models/lol/**/README.md

# Site packages
site-packages/

# Reports and docs build output
/reports/*
!/reports/README.md
!/reports/lol/
/reports/lol/*
!/reports/lol/README.md
!/reports/lol/**/
!/reports/lol/**/README.md

# Logs
/logs/*
!/logs/.gitkeep
!/logs/README.md
!/logs/lol/
/logs/lol/*
!/logs/lol/README.md

# Site folder
site/

# Testing script
test.py

# TXT files
*.txt

# Claude files
.claude/
